---
- name: Ensure the {{ resource.singular }} resource exists
  block:
{%- raw %}
    - name: Ensure the secret resource that stores the Quay parameters exists
      ansible.builtin.fail:
        msg: "connSecretRef: {{ conn_secret_ref['name'] }}: secret not found"
      when:
        - not secret_found

    - name: Retrieve the external registry credentials from the provided secret resource
      when:
        - external_registry_secret_ref is defined
        - "'name' in external_registry_secret_ref"
        - external_registry_secret_ref['name'] | length > 0
      block:
        - name: Retrieve the secret that stores the external registry credentials
          kubernetes.core.k8s_info:
            api_version: v1
            kind: Secret
            name: "{{ external_registry_secret_ref['name'] }}"
            namespace: "{{ external_registry_secret_ref['namespace']
              | default(ansible_operator_meta['namespace']) }}"
          register: ext_reg_secret_r

        - name: Ensure the external registry credentials secret exists
          ansible.builtin.fail:
            msg: "externalRegistrySecretRef: {{ external_registry_secret_ref['name'] }}: secret not found"
          when:
            - "ext_reg_secret_r['resources'] | length == 0 or
              'data' not in ext_reg_secret_r['resources'][0]"

        - name: Set the external registry credentials from the secret
          ansible.builtin.set_fact:
            external_registry_username: "{{ ext_reg_secret_r['resources'][0]['data']['username']
              | default('') | ansible.builtin.b64decode | default(omit, true) }}"
            external_registry_password: "{{ ext_reg_secret_r['resources'][0]['data']['password']
              | default('') | ansible.builtin.b64decode | default(omit, true) }}"
{%- endraw %}

    - name: Ensure the {{ resource.singular }} resource exists in Quay
      {{ resource.ansible_full_name }}:
{%- raw %}
        quay_host: "{{ quay_host | default(omit) }}"
        validate_certs: "{{ validate_certs | default(omit) }}"
        timeout: "{{ timeout | default(omit) }}"
        quay_token: "{{ quay_token | default(omit, true) }}"
        quay_username: "{{ omit if quay_token is defined and quay_token | length > 0 else quay_username | default(omit) }}"
        quay_password: "{{ omit if quay_token is defined and quay_token | length > 0 else quay_password | default(omit) }}"
{%- endraw %}
{%- for item in options %}
        {{ item }}: {{ "\"{{ " + item + " | default(omit) }}\"" -}}
{% endfor %}
      register: ret

    - name: Ensure the existInQuay flag is set in the resource status
      operator_sdk.util.k8s_status:
        api_version: {{ config.QUALIFIED_GROUP }}/{{ config.VERSION }}
        kind: {{ resource.kind }}
{%- raw %}
        name: "{{ ansible_operator_meta['name'] }}"
        namespace: "{{ ansible_operator_meta['namespace'] }}"
{%- endraw %}
        status:
          existInQuay: true

  rescue:
    - name: Ensure the error message is set in the resource status
      operator_sdk.util.k8s_status:
        api_version: {{ config.QUALIFIED_GROUP }}/{{ config.VERSION }}
        kind: {{ resource.kind }}
{%- raw %}
        name: "{{ ansible_operator_meta['name'] }}"
        namespace: "{{ ansible_operator_meta['namespace'] }}"
        status:
          message: "{{ ansible_failed_result['msg'] }}"

    - name: Ensure the error is raised
      ansible.builtin.fail:
        msg: "{{ ansible_failed_result['msg'] }}"
{%- endraw %}

- name: Ensure the error message is cleared from the resource status
  operator_sdk.util.k8s_status:
    api_version: {{ config.QUALIFIED_GROUP }}/{{ config.VERSION }}
    kind: {{ resource.kind }}
{%- raw %}
    name: "{{ ansible_operator_meta['name'] }}"
    namespace: "{{ ansible_operator_meta['namespace'] }}"
    status:
      message: ""
{%- endraw %}
